# Application
NODE_ENV=development
PORT=3001
FRONTEND_URL=http://localhost:3000

# Database
DATABASE_URL=postgresql://dobro:dobro123@localhost:5432/dobro_db
REDIS_URL=redis://localhost:6379

# AI Provider (выбери один)
# Вариант 1: Gemini (Google AI Studio) - БЕСПЛАТНО
# Получить ключ: https://aistudio.google.com/app/apikey
GEMINI_API_KEY=AIza-your-key-here

# Вариант 2: OpenAI (платно, но лучше качество)
# Получить ключ: https://platform.openai.com/api-keys
OPENAI_API_KEY=sk-proj-your-key-here
OPENAI_MODEL=gpt-4o-mini
OPENAI_MAX_TOKENS=4096

# Authentication
JWT_SECRET=your-super-secret-jwt-key-change-in-production
JWT_EXPIRES_IN=7d
JWT_REFRESH_EXPIRES_IN=30d

# Payment - Stripe
STRIPE_SECRET_KEY=sk_test_your_stripe_key
STRIPE_WEBHOOK_SECRET=whsec_your_webhook_secret
STRIPE_PRICE_ID_PRO=price_your_pro_plan
STRIPE_PRICE_ID_BUSINESS=price_your_business_plan

# Payment - ЮKassa (Russia)
YUKASSA_SHOP_ID=your_shop_id
YUKASSA_SECRET_KEY=your_secret_key

# Telegram Bot
TELEGRAM_BOT_TOKEN=your_bot_token_from_botfather
TELEGRAM_WEBHOOK_URL=https://your-domain.com/api/webhooks/telegram

# Email Service
SENDGRID_API_KEY=your_sendgrid_key
EMAIL_FROM=noreply@dobro.app

# Storage (S3 compatible)
S3_ENDPOINT=https://s3.amazonaws.com
S3_BUCKET=dobro-pdfs
S3_ACCESS_KEY=your_access_key
S3_SECRET_KEY=your_secret_key
S3_REGION=us-east-1

# Monitoring
SENTRY_DSN=your_sentry_dsn

# Rate Limiting
RATE_LIMIT_WINDOW_MS=900000
RATE_LIMIT_MAX_REQUESTS=100

# AI Generation Limits
MAX_GUIDES_FREE=3
MAX_GUIDES_PRO=50
MAX_GUIDES_BUSINESS=999999
